# Токен от @BotFather (обязательно)
BOT_TOKEN=123456:ABC...

# Telegram ID админов через запятую (необязательно): получают алерты об ошибках,
# им доступны команды /status и /refresh. Свой ID можно узнать у @userinfobot
ADMIN_IDS=

# Страница с кнопками «Расписание на ...» (по умолчанию — Юбилейная)
# SCHEDULE_PAGE_URL=  # страница ул. Юбилейная
# SCHEDULE_PAGE_URL_LUNACHARSKOGO=https://politex59.ru/studentam/raspisanie-zanyatiy/raspisanie-zanyatiy-ul-lunacharskogo/

# Как часто проверять сайт, секунд (по умолчанию 300)
# CHECK_INTERVAL=300
# Как часто перекачивать файлы, если ссылки не менялись, секунд (по умолчанию 3600)
# RECHECK_SECONDS=3600

# Часовой пояс для «сегодня/завтра»
# TZ_NAME=Asia/Yekaterinburg
# DB_PATH=bot.db
